{
  "name": "@byndyusoft/eslint-config",
  "version": "4.0.0",
  "description": "ESLint config for Byndyusoft projects",
  "type": "module",
  "main": "index.js",
  "files": [
    "*.js",
    "configs/",
    "utils/"
  ],
  "exports": {
    ".": "./index.js",
    "./backend": "./backend.js",
    "./frontend": "./frontend.js",
    "./javascript": "./javascript.js",
    "./typescript": "./typescript.js",
    "./flow": "./flow.js",
    "./header-apache-2.0": "./header-apache-2.0.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "node --test test/smoke.test.js",
    "lint": "eslint .",
    "prepare": "husky || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Byndyusoft/eslint-config.git"
  },
  "keywords": [
    "byndyusoft",
    "eslint",
    "eslint-config"
  ],
  "author": "Byndyusoft",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Byndyusoft/eslint-config/issues"
  },
  "homepage": "https://github.com/Byndyusoft/eslint-config#readme",
  "peerDependencies": {
    "eslint": ">=10.4.0"
  },
  "dependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-dirs": "^0.0.4",
    "eslint-plugin-header": "^3.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jest-formatting": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^65.0.1",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.61.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "eslint": "^10.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.4",
    "react": "^19.2.3",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write"
    ]
  }
}
