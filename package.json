{
  "name": "@byndyusoft/eslint-config",
  "version": "4.0.0-alpha.0",
  "description": "ESLint config for Byndyusoft projects",
  "type": "module",
  "main": "index.js",
  "files": [
    "*.js",
    "configs/",
    "utils/"
  ],
  "exports": {
    ".": "./index.js",
    "./advanced": "./advanced.js",
    "./backend": "./backend.js",
    "./frontend": "./frontend.js",
    "./header-apache-2.0": "./header-apache-2.0.js",
    "./javascript": "./javascript.js",
    "./jest": "./jest.js",
    "./jest-style-frontend": "./jest-style-frontend.js",
    "./node": "./node.js",
    "./react": "./react.js",
    "./react-testing": "./react-testing.js",
    "./typescript": "./typescript.js",
    "./typescript-style-backend": "./typescript-style-backend.js",
    "./typescript-style-frontend": "./typescript-style-frontend.js",
    "./vitest": "./vitest.js"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "test": "node --test test/smoke.test.js",
    "test:package": "node test/package-consumer.js",
    "lint": "eslint .",
    "prepare": "husky || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Byndyusoft/eslint-config.git"
  },
  "keywords": [
    "byndyusoft",
    "eslint",
    "eslint-config"
  ],
  "author": "Byndyusoft",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Byndyusoft/eslint-config/issues"
  },
  "homepage": "https://github.com/Byndyusoft/eslint-config#readme",
  "peerDependencies": {
    "eslint": "^10.4.0"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.23.3",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@tony.ganchev/eslint-plugin-header": "^3.4.4",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-dirs": "^0.0.4",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-jest-formatting": "^3.1.0",
    "eslint-plugin-n": "^18.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-a11y": "^2.5.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^65.0.1",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.61.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.7",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.4",
    "react": "^19.2.3",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write"
    ]
  }
}
